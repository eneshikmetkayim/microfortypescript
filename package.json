{
  "name": "microfortypescript",
  "version": "0.2.0",
  "private": true,
  "description": "MicroSIP 3.23.5 logic layer ported to TypeScript (SIP stack, dialing, URL masks, call log) with 1:1 parity tests.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eneshikmetkayim/microfortypescript.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "audit": "node scripts/audit.ts",
    "ci": "npm run typecheck && npm run test && npm run audit",
    "start": "node src/cli.ts",
    "web": "node src/cli.ts serve"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
